<Application x:Class="Axis.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Application.Resources>
<Style TargetType="TextBlock"><Setter Property="Foreground" Value="#EDF1FA"/><Setter Property="FontSize" Value="15"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
<Style TargetType="Button"><Setter Property="Foreground" Value="#F4F7FF"/><Setter Property="Background" Value="#26354F"/><Setter Property="Padding" Value="16,12"/><Setter Property="Margin" Value="0,4"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Cursor" Value="Hand"/>
<Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#425679"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="Background" Value="#425679"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".55"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="CheckBox"><Setter Property="Foreground" Value="White"/><Setter Property="Margin" Value="0,12"/><Setter Property="FontSize" Value="16"/></Style>
<Style TargetType="TextBox"><Setter Property="Background" Value="#202D42"/><Setter Property="Foreground" Value="#EDF1FA"/><Setter Property="CaretBrush" Value="White"/><Setter Property="BorderBrush" Value="#405473"/><Setter Property="Padding" Value="8"/><Setter Property="FontSize" Value="14"/></Style>
<Style TargetType="ListBox"><Setter Property="Background" Value="#182236"/><Setter Property="Foreground" Value="#EDF1FA"/><Setter Property="BorderBrush" Value="#405473"/><Setter Property="Padding" Value="6"/></Style>
<Style TargetType="ListBoxItem"><Setter Property="Foreground" Value="#EDF1FA"/><Setter Property="Padding" Value="10,7"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemSurface" Background="#182236" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#3D5476"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#30435F"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="ComboBoxItem"><Setter Property="Background" Value="#202D42"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="10,7"/></Style>
<Style TargetType="ComboBox"><Setter Property="Background" Value="#202D42"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
<ToggleButton Background="#202D42" Foreground="White" BorderBrush="#405473" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}" Focusable="False" HorizontalContentAlignment="Right"><TextBlock Text="▾" Margin="8"/></ToggleButton>
<ContentPresenter Margin="10,8,30,8" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" IsHitTestVisible="False"/>
<Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="#202D42" BorderBrush="#405473" BorderThickness="1" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="250"><ItemsPresenter/></ScrollViewer></Border></Popup>
</Grid></ControlTemplate></Setter.Value></Setter></Style>
</Application.Resources></Application>
